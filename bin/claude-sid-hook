#!/usr/bin/env python3
"""Claude Code SessionStart hook: record the current conversation id of a managed session.

bin/claude-session exports CLAUDE_SESSION_NAME=<name>; this hook writes the session_id Claude Code
passes on stdin to <sessions-dir>/<name>.sid at every start, resume and /clear, so a restart
reopens exactly that conversation. Outside a managed session it does nothing.
"""
import json, os, sys
from pathlib import Path

name = os.environ.get("CLAUDE_SESSION_NAME", "")
if name and all(c.isalnum() or c == "-" for c in name):
    sid = json.load(sys.stdin).get("session_id", "")
    d = Path(os.environ.get("CLAUDE_SESSIONS_DIR", Path.home() / ".config" / "claude-sessions"))
    if sid and (d / f"{name}.env").exists():
        old = os.umask(0o077)
        (d / f"{name}.sid").write_text(sid + "\n", encoding="utf-8")
        os.umask(old)
